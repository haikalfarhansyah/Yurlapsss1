# Simpan sebagai /etc/systemd/system/stintlab.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stintlab
[Unit]
Description=StintLab lap timing (OpenStint)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/stintlab
Environment=STINTLAB_DATA=/home/pi/stintlab-data
ExecStart=/usr/bin/python3 -m app --host 0.0.0.0 --port 8080 --no-browser
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
