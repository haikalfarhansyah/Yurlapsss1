# GitHub Actions di Windows memakai core.autocrlf=true. Berkas berikut HARUS
# tetap LF, kalau tidak `git apply` gagal ("patch does not apply") karena
# setiap baris konteks patch berakhir \r.
*.patch          text eol=lf
decoder/cara.ps1 text eol=crlf
*.yml            text eol=lf
*.py             text eol=lf
